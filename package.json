{
  "name": "afterhours-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test tests/recovery/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests data",
    "recovery:source": "node tools/recover-wrapper.mjs",
    "recovery:inventory": "node tools/inventory-backup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0"
  }
}
